<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.10.4/spotbugs/etc/findbugsfilter.xsd">

    <!--
        Records model transfer objects deserialized from service responses and components store injected
        collaborators such as WebClientService. Defensive copies on every accessor would add allocation to the
        streaming data path without protecting against a caller within the same ClassLoader.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>

    <!-- Amazon Signature Version 4 canonical headers require line feed separators independent of platform -->
    <Match>
        <Class name="net.snowflake.openflow.components.snowpipe.streaming.transfer.S3ObjectTransferClient" />
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE" />
    </Match>

    <!-- Snowpark Container Services mounts credentials at fixed paths that the secondary constructor overrides -->
    <Match>
        <Class name="net.snowflake.openflow.components.snowpipe.streaming.authorization.SnowflakeManagedTokenAuthorizationProvider" />
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME" />
    </Match>

    <!-- Retrying a File Fragment transfer rethrows the original failure after restoring the interrupt status -->
    <Match>
        <Class name="net.snowflake.openflow.processors.snowpipe.streaming.StandardSnowpipeStreamingService" />
        <Method name="insertFileFragments" />
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    </Match>
</FindBugsFilter>
